# Use your real Atlas connection string for Vercel or another remote deployment target.
# Example shape only:
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>
DATABASE_URL=

# Use a long random secret for Payload auth/session signing.
PAYLOAD_SECRET=

# Cloudflare R2 media storage
# Set R2_MEDIA_STORAGE_ENABLED=true in environments where the app should read/write media through R2.
# Keep this false only for local scenarios where you explicitly do not want the media collection to use R2.
R2_MEDIA_STORAGE_ENABLED=false
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public/custom-domain base URL that serves uploaded objects, without a trailing slash.
R2_PUBLIC_URL=
